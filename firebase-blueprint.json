{
  "entities": {
    "Profile": {
      "title": "Profile",
      "description": "Fleet owner profile and default financial/operational configuration.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated fleet owner.",
          "minLength": 1,
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Email address of the owner.",
          "minLength": 3,
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "description": "Full name or business title of the fleet operator.",
          "minLength": 1,
          "maxLength": 100
        },
        "businessName": {
          "type": "string",
          "description": "Registered fleet or transport business name.",
          "minLength": 1,
          "maxLength": 120
        },
        "defaultDriverSharePct": {
          "type": "number",
          "description": "Default percentage of eligible earnings allocated to driver share (0 to 100).",
          "minimum": 0,
          "maximum": 100
        },
        "currency": {
          "type": "string",
          "enum": ["INR"],
          "description": "Fixed reporting currency (INR)."
        },
        "distanceUnit": {
          "type": "string",
          "enum": ["km"],
          "description": "Fixed distance unit (kilometres)."
        },
        "timezone": {
          "type": "string",
          "enum": ["Asia/Kolkata"],
          "description": "Fixed operational timezone."
        },
        "intendedGoogleDriveEmail": {
          "type": "string",
          "description": "Target Google account email for Drive backups.",
          "minLength": 3,
          "maxLength": 160
        },
        "expiryAlertDays": {
          "type": "number",
          "description": "Configurable warning window in days before statutory document expiry (1 to 180).",
          "minimum": 1,
          "maximum": 180
        },
        "serviceWarningKm": {
          "type": "number",
          "description": "Configurable odometer buffer in km before next preventive service due (100 to 10000).",
          "minimum": 100,
          "maximum": 10000
        },
        "accountMode": {
          "type": "string",
          "enum": ["Individual", "Organization"],
          "description": "Whether the account is configured for Individual use or Multi-User Organization use."
        },
        "organizationName": {
          "type": "string",
          "description": "Name of the fleet organization when accountMode is Organization.",
          "minLength": 0,
          "maxLength": 120
        },
        "alertEmail": {
          "type": "string",
          "description": "Target email address for 10d, 5d, and 1d compliance expiry alerts.",
          "minLength": 3,
          "maxLength": 160
        },
        "whatsappNumber": {
          "type": "string",
          "description": "Target WhatsApp phone number for 10d, 5d, and 1d compliance expiry alerts.",
          "minLength": 5,
          "maxLength": 25
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation.",
          "minLength": 1,
          "maxLength": 40
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update.",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "ownerId",
        "email",
        "displayName",
        "businessName",
        "defaultDriverSharePct",
        "currency",
        "distanceUnit",
        "timezone",
        "intendedGoogleDriveEmail",
        "createdAt",
        "updatedAt"
      ]
    },
